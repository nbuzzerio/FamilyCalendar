{
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.9.0"
  },
  "name": "family-calendar",
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "scripts": {
    "test": "node --experimental-strip-types --test --test-isolation=none src/events.test.mjs src/app.test.mjs",
    "build": "pnpm run typecheck && node --preserve-symlinks --preserve-symlinks-main studio-tools/vite-build.mjs && node studio-tools/offline-shell.mjs",
    "test:sync": "pnpm run build && node --test tests/sync-browser.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:sync": "pnpm run build && node tests/local-service.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.0"
}
